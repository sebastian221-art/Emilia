# ARCHIVO: .env.example — copia a .env y llena lo que uses. Nunca subas el .env real.

# ── Base y servidor ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:CLAVE@localhost:5432/emilia
PORT=3000

# ── Modelos ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# CLAUDE_SONNET_ID=claude-sonnet-5-5
# CLAUDE_HAIKU_ID=claude-haiku-5-5
# CLAUDE_OPUS_ID=claude-opus-5-5

# ── WhatsApp Business ────────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_NUMERO_JEFE=
# Plantilla aprobada para avisos fuera de la ventana de 24 h:
WHATSAPP_PLANTILLA_AVISO=recordatorio_emilia
# Solo al jefe por defecto; otros números permitidos separados por coma:
# WHATSAPP_NUMEROS_PERMITIDOS=
# WHATSAPP_PERMITIR_TERCEROS=false

# ── Jelcom Envíos ────────────────────────────────────────────────────────────
JELCOM_URL=
JELCOM_API_KEY=

# ── Sage: Claude Code y laboratorio ──────────────────────────────────────────
# Claude Code usa tu plan Max (corre "claude" y /login una vez). true = cobrar a la API en vez del plan.
# CLAUDE_CODE_USAR_API=false
# CLAUDE_CODE_PARALELO=3
# CLAUDE_CODE_PRESUPUESTO_USD=5
# Variables extra (separadas por coma) que Claude Code puede ver; por defecto NO ve los secretos de Emilia.
# CLAUDE_CODE_ENTORNO_EXTRA=
# LAB_DIR=C:\Users\TU_USUARIO\EmiliaLab
# Segundos que se espera tu "ok" por WhatsApp antes de dar por rechazado:
# PERMISO_ESPERA_SEG=900

# ── Sage: publicar (GitHub + Railway) ────────────────────────────────────────
GITHUB_TOKEN=
# Token de CUENTA de Railway (railway.com/account/tokens):
RAILWAY_TOKEN=

# ── Sage: guardia de código ──────────────────────────────────────────────────
# GUARDIA_CADA_MIN=30
# GUARDIA_RESUMEN_CRON=0 19 * * *
# GUARDIA_MAX_REPARACIONES=2

# ── Uso del computador (Claude ve la pantalla y maneja mouse y teclado) ──────
PC_HABILITADO=false
# claude:sonnet (defecto), claude:opus para tareas difíciles, claude:haiku para lo simple:
# COMPUTER_USE_MODELO=claude:sonnet
# Tamaño de las capturas que ve Claude (más grande = más preciso y más caro):
# COMPUTER_USE_ANCHO=1366
# COMPUTER_USE_ALTO=1024
# Días que se guardan capturas y bitácoras de las sesiones (pueden tener datos sensibles):
# PC_SESIONES_DIAS=30
# v2 = usar el operador anterior en vez de Claude:
# PC_MOTOR=claude
