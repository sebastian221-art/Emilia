# ARCHIVO: .env.example — copia a .env y llena lo que uses. Nunca subas el .env real.

# ── Base y servidor ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:CLAVE@localhost:5432/emilia
PORT=3000

# ── Modelos ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# CLAUDE_SONNET_ID=claude-sonnet-5-5
# CLAUDE_HAIKU_ID=claude-haiku-5-5
# CLAUDE_OPUS_ID=claude-opus-5-5

# ── WhatsApp Business ────────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_NUMERO_JEFE=
# Plantilla aprobada para avisos fuera de la ventana de 24 h:
WHATSAPP_PLANTILLA_AVISO=recordatorio_emilia
# Solo al jefe por defecto; otros números permitidos separados por coma:
# WHATSAPP_NUMEROS_PERMITIDOS=
# WHATSAPP_PERMITIR_TERCEROS=false

# ── Jelcom Envíos ────────────────────────────────────────────────────────────
JELCOM_URL=
JELCOM_API_KEY=

# ── Sage: Claude Code y laboratorio ──────────────────────────────────────────
# Claude Code usa tu plan Max (corre "claude" y /login una vez). true = cobrar a la API en vez del plan.
# CLAUDE_CODE_USAR_API=false
# CLAUDE_CODE_PARALELO=3
# CLAUDE_CODE_PRESUPUESTO_USD=5
# Variables extra (separadas por coma) que Claude Code puede ver; por defecto NO ve los secretos de Emilia.
# CLAUDE_CODE_ENTORNO_EXTRA=
# LAB_DIR=C:\Users\TU_USUARIO\EmiliaLab
# Segundos que se espera tu "ok" por WhatsApp antes de dar por rechazado:
# PERMISO_ESPERA_SEG=900

# ── Sage: publicar (GitHub + Railway) ────────────────────────────────────────
GITHUB_TOKEN=
# Token de CUENTA de Railway (railway.com/account/tokens):
RAILWAY_TOKEN=

# ── Sage: guardia de código ──────────────────────────────────────────────────
# GUARDIA_CADA_MIN=30
# GUARDIA_RESUMEN_CRON=0 19 * * *
# GUARDIA_MAX_REPARACIONES=2

# ── Uso del computador (Claude ve la pantalla y maneja mouse y teclado) ──────
PC_HABILITADO=false
# claude:sonnet (defecto), claude:opus para tareas difíciles, claude:haiku para lo simple:
# COMPUTER_USE_MODELO=claude:sonnet
# Tamaño de las capturas que ve Claude (más grande = más preciso y más caro):
# COMPUTER_USE_ANCHO=1366
# COMPUTER_USE_ALTO=1024
# Días que se guardan capturas y bitácoras de las sesiones (pueden tener datos sensibles):
# PC_SESIONES_DIAS=30
# v2 = usar el operador anterior en vez de Claude:
# PC_MOTOR=claude

# ── Iris: correo (Gmail con contraseña de aplicación) ────────────────────────
# Una cuenta por número. La clave NO es la de Gmail: es una "contraseña de
# aplicación" (myaccount.google.com/apppasswords, requiere verificación en 2 pasos).
CORREO_1_NOMBRE=personal
CORREO_1_USUARIO=
CORREO_1_CLAVE=
CORREO_2_NOMBRE=empresa
CORREO_2_USUARIO=
CORREO_2_CLAVE=
# Si alguna cuenta no es Gmail: CORREO_2_IMAP_HOST / IMAP_PORT / SMTP_HOST / SMTP_PORT
# Nombre con que firmas (si no, lo toma de tus correos enviados):
# CORREO_REMITENTE_EMPRESA=Sebastián · Jelcom
# IRIS_MODELO_CORREO=claude:haiku      # leer y clasificar cada correo
# IRIS_MODELO_REDACTAR=claude:sonnet   # redactar respuestas en tu estilo

# ── Iris: Google Calendar (opcional) ─────────────────────────────────────────
# console.cloud.google.com → API de Calendar → credencial OAuth "App de escritorio".
# Luego: npm run google:conectar (abre el navegador una vez).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Iris: copias de la base ──────────────────────────────────────────────────
# COPIAS_DIR=C:\Users\TU_USUARIO\EmiliaCopias
# COPIAS_HORA=03:00
# Carpeta bin de PostgreSQL si pg_dump no está en el PATH:
# PG_BIN=C:\Program Files\PostgreSQL\16\bin

# ── Iris: calidad de Any (chatbot del centro comercial) ──────────────────────
# Usuario del panel de Any (mejor uno propio para Iris, rol supervisor).
ANY_URL=
ANY_USUARIO=
ANY_CLAVE=
# ANY_MODO=produccion          # vacío = también las conversaciones de prueba
# ANY_CADA_MIN=15
# ANY_PROYECTO=chat_bot_cc     # nombre del proyecto registrado para Sage
# IRIS_MODELO_ANY=claude:haiku

# ── Soga: buscador ───────────────────────────────────────────────────────────
# Servicios locales (Docker Desktop): docker compose -f scripts/soga/docker-compose.yml up -d
SEARXNG_URL=http://127.0.0.1:8888
LIGHTPANDA_URL=http://127.0.0.1:9222
# Clave aleatoria para SearXNG (cualquier texto largo):
# SEARXNG_SECRET=
# Búsqueda de Claude ($10 por 1.000 búsquedas + tokens). Tope diario de búsquedas:
# SOGA_CLAUDE_BUSQUEDA=true
# SOGA_CLAUDE_BUSQUEDAS_DIA=60
# SOGA_MODELO_BUSQUEDA=claude:haiku
# Abrir un navegador para páginas que se arman con JavaScript (true por defecto):
# SOGA_NAVEGADOR=true
# Opcional, 2.000 búsquedas gratis al mes:
# BRAVE_SEARCH_API_KEY=
# Videos y pódcast: yt-dlp y ffmpeg instalados (pip install yt-dlp · winget install yt-dlp ffmpeg)
# YTDLP_BIN=yt-dlp
# FFMPEG_BIN=ffmpeg
# Máximo de minutos a transcribir del audio cuando un video no tiene subtítulos:
# SOGA_AUDIO_MAX_MIN=120
# SOGA_MODELO_RESUMEN=claude:haiku
# Opcionales: más cupo en OpenRouter (modelos) y en datos.gov.co (SECOP, TRM)
# OPENROUTER_API_KEY=
# SOCRATA_APP_TOKEN=
# Radar y cazadora de herramientas:
# SOGA_MODELO_RADAR=claude:haiku
# SOGA_MODELO_CAZADOR=claude:haiku
