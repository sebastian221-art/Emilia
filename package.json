        "multer": "^1.4.5-lts.1",
        "pg": "^8.12.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.14.2",
        "@types/pg": "^8.11.6",
        "tsx": "^4.15.6",
        "typescript": "^5.5.2"
    }
